<?xml version="1.0" encoding="UTF-8"?>
<?page title="Data Entry" contentType="text/html;charset=UTF-8"?>

<zk>

    <window
        id="dataEntryWindow"
        title="Data Entry"
        border="normal"
        width="100%"
        height="100%"
        apply="com.cts.outward.controller.maker.DataEntryController">

        <vlayout
            width="100%"
            height="100%"
            spacing="0"
            style="padding:20px; box-sizing:border-box;">

            <!-- ================================================= -->
            <!-- PAGE HEADER -->
            <!-- ================================================= -->

            <vlayout
                width="100%"
                spacing="5px"
                style="margin-bottom:20px;">

                <label
                    value="Data Entry"
                    style="font-size:28px;
                           font-weight:bold;
                           color:#17365d;" />

                <label
                    value="All cheques available for Data Entry"
                    style="font-size:14px;
                           color:#6b7280;" />

            </vlayout>


            <!-- ================================================= -->
            <!-- BATCH INFORMATION -->
            <!-- ================================================= -->

            <groupbox
                width="100%"
                height="80px"
                closable="false"
                style="background:#eef6ff;
                       border:1px solid #b8d7ff;
                       margin-bottom:20px;">

                <hlayout
                    width="100%"
                    height="100%"
                    valign="middle"
                    style="padding:15px;
                           box-sizing:border-box;">

                    <label
                        value="Batch:"
                        style="font-size:16px;
                               font-weight:bold;
                               color:#17365d;
                               margin-right:10px;" />

                    <label
                        id="batchNumberLabel"
                        value="-"
                        style="font-size:16px;
                               font-weight:bold;
                               color:#0757c7;" />

                    <label
                        value="Total Cheques:"
                        style="font-size:16px;
                               font-weight:bold;
                               color:#17365d;
                               margin-left:40px;
                               margin-right:10px;" />

                    <label
                        id="totalChequeLabel"
                        value="0"
                        style="font-size:16px;
                               font-weight:bold;
                               color:#0757c7;" />

                </hlayout>

            </groupbox>


            <!-- ================================================= -->
            <!-- CHEQUE TABLE -->
            <!-- ================================================= -->

            <groupbox
                width="100%"
                height="500px"
                closable="false"
                mold="3d">

                <caption
                    label="Cheque List" />

                <listbox
                    id="chequeList"
                    width="100%"
                    height="100%"
                    emptyMessage="No cheques found for this batch.">

                    <listhead>

                        <listheader
                            label="S.No"
                            width="10%" />

                        <listheader
                            label="Cheque No"
                            width="20%" />

                        <listheader
                            label="Account No"
                            width="20%" />

                        <listheader
                            label="Amount"
                            width="15%" />

                        <listheader
                            label="Status"
                            width="15%" />

                        <listheader
                            label="Action"
                            width="20%" />

                    </listhead>

                </listbox>

            </groupbox>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <hlayout
                width="100%"
                height="50px"
                valign="middle"
                style="margin-top:15px;
                       border-top:1px solid #d9d9d9;
                       padding-top:10px;
                       box-sizing:border-box;">

                <label
                    id="chequeCount"
                    value="Total Cheques: 0"
                    style="font-size:14px;
                           font-weight:bold;
                           color:#17365d;" />

            </hlayout>

        </vlayout>

    </window>

</zk>