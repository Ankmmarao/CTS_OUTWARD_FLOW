<?page title="Maker Dashboard"?>

<?link rel="stylesheet" type="text/css" href="/css/capture.css"?>

<zk>

<window
    border="none"
    width="100%"
    height="100%"
    apply="com.cts.outward.controller.maker.MakerDashboardController">

    <vlayout
        spacing="0"
        width="100%"
        height="100%"
        sclass="maker-page">

        <!-- ================= HEADER ================= -->

        <div sclass="top-header">

            <hlayout
                width="100%"
                height="70px"
                valign="middle">

                <label
                    value="☰"
                    sclass="header-icon"/>

                <label
                    value="CTS OUTWARD / MAKER"
                    sclass="header-title"/>

                <div hflex="1"/>

                <label
                    value="▣  Date : 01-09-2026"
                    sclass="header-info"/>

                <label
                    value="◷  Last Login : 01-09-2026 09:15 AM"
                    sclass="header-info"/>

                <label
                    value="♧"
                    sclass="header-icon"/>

                <label
                    value="◯"
                    sclass="header-icon"/>

            </hlayout>

        </div>


        <!-- ================= BODY ================= -->

        <hlayout
            width="100%"
            height="calc(100% - 70px)"
            spacing="0">


            <!-- ================= SIDEBAR ================= -->

            <vlayout
                spacing="5px"
                sclass="sidebar">

                <!-- DASHBOARD -->

                <div
                    sclass="sidebar-item sidebar-item-selected">

                    <hlayout
                        height="55px"
                        valign="middle">

                        <label
                            value="⌂"
                            sclass="sidebar-icon-selected"/>

                        <label
                            value="Dashboard"
                            sclass="sidebar-text-selected"/>

                    </hlayout>

                </div>


                <!-- DATA ENTRY -->

                <div
                    sclass="sidebar-item">

                    <hlayout
                        height="55px"
                        valign="middle">

                        <label
                            value="▣"
                            sclass="sidebar-icon"/>

                        <label
                            value="Data Entry"
                            sclass="sidebar-text"/>

                    </hlayout>

                </div>


                <!-- MICR REPAIR -->

                <div
                    sclass="sidebar-item">

                    <hlayout
                        height="55px"
                        valign="middle">

                        <label
                            value="✎"
                            sclass="sidebar-icon"/>

                        <label
                            value="MICR Repair"
                            sclass="sidebar-text"/>

                    </hlayout>

                </div>


                <!-- AMOUNT AND ACCOUNT -->

                <div
                    sclass="sidebar-item">

                    <hlayout
                        height="55px"
                        valign="middle">

                        <label
                            value="₹"
                            sclass="sidebar-icon"/>

                        <label
                            value="Amount And Account"
                            sclass="sidebar-text"/>

                    </hlayout>

                </div>


                <!-- SEND TO CHECKER -->

                <div
                    sclass="sidebar-item">

                    <hlayout
                        height="55px"
                        valign="middle">

                        <label
                            value="➜"
                            sclass="sidebar-icon"/>

                        <label
                            value="Send to Checker"
                            sclass="sidebar-text"/>

                    </hlayout>

                </div>

            </vlayout>


            <!-- ================= MAIN CONTENT ================= -->

            <vlayout
                hflex="1"
                spacing="20px"
                sclass="main-content">


                <!-- PAGE TITLE -->

                <vlayout spacing="5px">

                    <label
                        value="Maker Dashboard"
                        sclass="page-title"/>

                    <label
                        value="Available batches assigned for processing."
                        sclass="page-subtitle"/>

                </vlayout>


                <!-- ================= SUMMARY ================= -->

                <hlayout
                    spacing="20px">

                    <!-- TOTAL BATCHES -->

                    <groupbox
                        width="220px"
                        height="110px"
                        closable="false"
                        sclass="summary-card">

                        <caption
                            label="Total Batches"/>

                        <label
                            id="totalBatches"
                            value="0"
                            style="font-size:28px;
                                   font-weight:bold;
                                   padding:20px;"/>

                    </groupbox>


                    <!-- AVAILABLE -->

                    <groupbox
                        width="220px"
                        height="110px"
                        closable="false"
                        sclass="summary-card">

                        <caption
                            label="Available Batches"/>

                        <label
                            id="availableBatches"
                            value="0"
                            style="font-size:28px;
                                   font-weight:bold;
                                   padding:20px;"/>

                    </groupbox>


                    <!-- IN PROGRESS -->

                    <groupbox
                        width="220px"
                        height="110px"
                        closable="false"
                        sclass="summary-card">

                        <caption
                            label="In Progress"/>

                        <label
                            id="inProgressBatches"
                            value="0"
                            style="font-size:28px;
                                   font-weight:bold;
                                   padding:20px;"/>

                    </groupbox>

                </hlayout>


                <!-- ================= BATCH TABLE ================= -->

                <groupbox
                    hflex="1"
                    closable="false">

                    <caption
                        label="Batches"/>


                    <listbox
                        id="batchList"
                        width="100%"
                        height="100%"
                        emptyMessage="No batches available.">

                        <listhead>

                            <listheader
                                label="Batch No"
                                width="18%"/>

                            <listheader
                                label="Total Cheques"
                                width="15%"/>

                            <listheader
                                label="Status"
                                width="15%"/>

                            <listheader
                                label="User ID"
                                width="15%"/>

                            <listheader
                                label="Assignment"
                                width="20%"/>

                            <listheader
                                label="Action"
                                width="17%"/>

                        </listhead>

                    </listbox>

                </groupbox>

            </vlayout>

        </hlayout>

    </vlayout>

</window>


</zk>
