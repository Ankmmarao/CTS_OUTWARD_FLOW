<?page title="Submitted Batches"?>

<zk>

    <window
        title="Submitted Batches"
        border="normal"
        width="100%"
        height="100%"
        apply="com.cts.outward.controller.capture.SubmittedBatchesController">

        <vlayout
            width="100%"
            height="100%"
            
            spacing="0px">

            <!-- ================= HEADER ================= -->

            <hlayout
                width="100%"
                height="70px"
                valign="middle"
                style="background:#ffffff; border-bottom:1px solid #e5e7eb; padding:0px 25px;">

                <vlayout
                    hflex="1"
                    spacing="2px">

                    <label
                        value="CTS OUTWARD"
                        style="font-size:20px; font-weight:bold; color:#1f2937;"/>

                    <label
                        value="CAPTURE OPERATOR"
                        style="font-size:12px; color:#6b7280;"/>

                </vlayout>

                <!-- Date -->

                <vlayout
                    width="150px"
                    spacing="2px">

                    <label
                        value="Date"
                        style="font-size:11px; color:#6b7280;"/>

                    <label
                        id="currentDate"
                        value="01-09-2026"
                        style="font-size:13px; font-weight:bold;"/>

                </vlayout>

                <!-- Last Login -->

                <vlayout
                    width="180px"
                    spacing="2px">

                    <label
                        value="Last Login"
                        style="font-size:11px; color:#6b7280;"/>

                    <label
                        id="lastLogin"
                        value="01-09-2026 09:15 AM"
                        style="font-size:13px; font-weight:bold;"/>

                </vlayout>

                <!-- Notification -->

                <button
                    id="notificationButton"
                    label="🔔"
                    width="45px"
                    height="40px"
                    style="font-size:18px; border:none; background:transparent;"/>

                <!-- Profile -->

                <button
                    id="profileButton"
                    label="👤"
                    width="45px"
                    height="40px"
                    style="font-size:18px; border:none; background:transparent;"/>

            </hlayout>


            <!-- ================= BODY ================= -->

            <hlayout
                width="100%"
                height="100%"
                spacing="0px">

                <!-- ================= SIDEBAR ================= -->

                <vlayout
                    width="220px"
                    height="100%"
                    spacing="5px"
                    style="background:#f8fafc; border-right:1px solid #e5e7eb; padding:20px 10px;">

                    <label
                        value="CAPTURE OPERATOR"
                        style="font-size:12px; font-weight:bold; color:#6b7280; padding:10px;"/>

                    <button
                        id="batchCaptureButton"
                        label="Batch Capture"
                        width="100%"
                        height="45px"
                        style="text-align:left; border:none; background:transparent; padding-left:15px;"/>

                    <button
                        id="submittedBatchesButton"
                        label="Submitted Batches"
                        width="100%"
                        height="45px"
                        style="text-align:left; border:none; background:#e5e7eb; font-weight:bold; padding-left:15px;"/>

                </vlayout>


                <!-- ================= CONTENT ================= -->

                <vlayout
                    hflex="1"
                    height="100%"
                    spacing="20px"
                    style="padding:30px; background:#f9fafb;">

                    <!-- Page Heading -->

                    <vlayout spacing="5px">

                        <label
                            value="Submitted Batches"
                            style="font-size:24px; font-weight:bold; color:#111827;"/>

                        <label
                            value="Batches submitted for further processing."
                            style="font-size:13px; color:#6b7280;"/>

                    </vlayout>


                    <!-- ================= SUMMARY ================= -->

                    <groupbox
                        width="220px"
                        height="90px"
                        closable="false">

                        <caption
                            label="Total Submitted Batches"/>

                        <label
                            id="totalSubmitted"
                            value="0"
                            style="font-size:25px; font-weight:bold; padding:15px;"/>

                    </groupbox>


                    <!-- ================= TABLE ================= -->

                    <groupbox
                        width="100%"
                        hflex="1"
                        closable="false">

                        <caption
                            label="Submitted Batch List"/>

                        <listbox
                            id="submittedBatchList"
                            width="100%"
                            height="100%"
                            emptyMessage="No submitted batches found.">

                            <listhead>

                                <listheader
                                    label="Batch Number"
                                    width="40%"/>

                                <listheader
                                    label="Total Cheques"
                                    width="30%"/>

                                <listheader
                                    label="Status"
                                    width="30%"/>

                            </listhead>

                        </listbox>

                    </groupbox>

                </vlayout>

            </hlayout>

        </vlayout>

    </window>

</zk>