<?page title="Submitted Batches"?>

<?link rel="stylesheet" type="text/css" href="/css/capture.css"?>

<zk>

    <window
        border="none"
        width="100%"
        height="100%"
        apply="com.cts.outward.controller.capture.SubmittedBatchesController">

        <vlayout
            width="100%"
            height="100%"
            spacing="0"
            sclass="capture-page">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <div
                width="100%"
                height="70px"
                sclass="top-header">

                <hlayout
                    width="100%"
                    height="70px"
                    valign="middle">

                    <label
                        value="☰"
                        sclass="header-icon"/>

                    <label
                        value="CTS OUTWARD / CAPTURE OPERATOR"
                        sclass="header-title"/>

                    <space hflex="1"/>

                    <label
                        value="▣  Date : 01-09-2026"
                        sclass="header-info"/>

                    <label
                        value="◷  Last Login : 01-09-2026 09:15 AM"
                        sclass="header-info"/>

                    <label
                        value="♧"
                        sclass="header-icon"/>

                    <label
                        value="◯"
                        sclass="header-icon"/>

                </hlayout>

            </div>


            <!-- ================================================= -->
            <!-- BODY -->
            <!-- ================================================= -->

            <hlayout
                width="100%"
                height="calc(100% - 70px)"
                spacing="0">


                <!-- ================================================= -->
                <!-- SIDEBAR -->
                <!-- ================================================= -->

                <vlayout
                    width="230px"
                    height="100%"
                    spacing="5px"
                    sclass="sidebar">


                    <!-- BATCH CAPTURE -->

                    <button
                        id="batchCaptureButton"
                        label="⌗   Batch Capture"
                        width="230px"
                        height="55px"
                        sclass="sidebar-nav-button"/>


                    <!-- SUBMITTED BATCHES -->

                    <button
                        id="submittedBatchesButton"
                        label="☷   Submitted Batches"
                        width="230px"
                        height="55px"
                        sclass="sidebar-nav-button sidebar-nav-button-selected"/>

                </vlayout>


                <!-- ================================================= -->
                <!-- MAIN CONTENT -->
                <!-- ================================================= -->

                <vlayout
                    hflex="1"
                    height="100%"
                    spacing="20px"
                    sclass="main-content">


                    <!-- PAGE HEADING -->

                    <vlayout
                        spacing="5px">

                        <label
                            value="Submitted Batches"
                            sclass="page-title"/>

                        <label
                            value="Batches submitted for further processing."
                            sclass="page-description"/>

                    </vlayout>


                    <!-- ================================================= -->
                    <!-- SUMMARY -->
                    <!-- ================================================= -->

                    <groupbox
                        width="250px"
                        height="100px"
                        closable="false"
                        sclass="submitted-summary">

                        <vlayout
                            width="100%"
                            height="100%"
                            spacing="5px">

                            <label
                                value="Total Submitted Batches"
                                sclass="summary-label"/>

                            <label
                                id="totalSubmitted"
                                value="0"
                                sclass="summary-value"/>

                        </vlayout>

                    </groupbox>


                    <!-- ================================================= -->
                    <!-- TABLE -->
                    <!-- ================================================= -->

                    <groupbox
                        hflex="1"
                        closable="false"
                        sclass="submitted-table-card">

                        <caption
                            label="Submitted Batch List"/>

                        <listbox
                            id="submittedBatchList"
                            width="100%"
                            height="100%"
                            emptyMessage="No submitted batches found."
                            sclass="submitted-listbox">

                            <listhead>

                                <listheader
                                    label="Batch Number"
                                    width="40%"/>

                                <listheader
                                    label="Total Cheques"
                                    width="30%"/>

                                <listheader
                                    label="Status"
                                    width="30%"/>

                            </listhead>

                        </listbox>

                    </groupbox>

                </vlayout>

            </hlayout>

        </vlayout>

    </window>

</zk>